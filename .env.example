# Copy to .env locally or enter these values in Coolify.
# Replace every CHANGE_ME value with a unique random value before starting.
POSTGRES_DB=notesphere
POSTGRES_USER=CHANGE_ME_DATABASE_ADMIN_USERNAME
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_A_UNIQUE_ADMIN_PASSWORD
APP_DB_USER=CHANGE_ME_APPLICATION_DATABASE_USERNAME
APP_DB_PASSWORD=CHANGE_ME_GENERATE_A_DIFFERENT_APPLICATION_PASSWORD
POSTGRES_PORT=5432
APP_AUTH_USERNAME=CHANGE_ME_LOGIN_USERNAME
APP_AUTH_PASSWORD=CHANGE_ME_GENERATE_A_UNIQUE_LOGIN_PASSWORD
BACKEND_PORT=8080
FRONTEND_PORT=5173
APP_MAX_ARCHIVE_SIZE=260MB
APP_MAX_UPLOAD_SIZE=25MB
# Leave empty for the same-origin frontend/API deployment.
APP_CORS_ALLOWED_ORIGINS=
